{
  "style_name": "Minimal Editorial Medical Concept Illustration",
  "visual_language": {
    "overall": "clean editorial infographic, conceptual icon illustration, flat vector with subtle depth",
    "background": "pure white",
    "composition": "single centered concept with generous whitespace",
    "aspect_ratio": "1:1",
    "camera": "orthographic front view",
    "lighting": "soft ambient, almost shadowless"
  },
  "design": {
    "stroke": {
      "color": "#111111",
      "weight": "3px",
      "caps": "round",
      "joins": "round"
    },
    "fills": {
      "primary": "#FFFFFF",
      "accent": "#A98BFF",
      "secondary": "#7D5CFF"
    },
    "accent_style": {
      "description": "random translucent geometric blocks placed behind the illustration",
