import requests
import time
import os
import sys

API_KEY = "MS6b2d6d7d3fb64d30960c9856197a9f83"
ENDPOINT = "https://api.magnific.com/v1/ai/text-to-image/nano-banana-pro"
OUTPUT_DIR = os.path.dirname(os.path.abspath(__file__))

# Read prompt
prompt_path = os.path.join(OUTPUT_DIR, "descent-prequel-3x3.prompt.txt")
with open(prompt_path, "r", encoding="utf-8") as f:
    prompt = f.read().strip()

print(f"Prompt length: {len(prompt)} chars")
print(f"Submitting to Magnific nano-banana-pro...")

headers = {
    "x-magnific-api-key": API_KEY,
    "Content-Type": "application/json"
}
body = {
    "prompt": prompt,
    "aspect_ratio": "16:9",
    "resolution": "2K"
}

# Submit
resp = requests.post(ENDPOINT, json=body, headers=headers)
print(f"HTTP {resp.status_code}")
print(f"Response keys: {list(resp.json().keys())}")
print(f"Response: {resp.text[:500]}")

if resp.status_code != 200 and resp.status_code != 201:
    print(f"ERROR: {resp.text}")
    sys.exit(1)

data = resp.json()
# Try multiple possible task_id field names
task_id = data.get("task_id") or data.get("id") or data.get("taskId") or data.get("generation_id")
if not task_id:
    # Maybe nested
    if "data" in data:
        task_id = data["data"].get("task_id") or data["data"].get("id")
    if not task_id and "task" in data:
        task_id = data["task"].get("id") or data["task"].get("task_id")

print(f"Task ID: {task_id}")
print(f"Status: {data.get('status')}")

if not task_id:
    print("FATAL: Could not extract task_id from response")
    sys.exit(1)

# Poll
while True:
    time.sleep(3)
    poll = requests.get(f"{ENDPOINT}/{task_id}", headers=headers)
    if poll.status_code != 200:
        print(f"Poll error {poll.status_code}: {poll.text[:200]}")
        # Check if already completed
        if poll.status_code == 404:
            print("Task not found — may have completed immediately. Checking response...")
            time.sleep(2)
            continue
        time.sleep(2)
        continue
    
    pdata = poll.json()
    status = pdata.get("status") or pdata.get("state")
    print(f"  ... {status}")
    
    if status in ("COMPLETED", "completed", "succeeded", "SUCCESS"):
        generated = (pdata.get("generated") or pdata.get("output") or 
                     pdata.get("images") or pdata.get("results") or [])
        if isinstance(generated, list) and len(generated) > 0:
            g0 = generated[0]
            if isinstance(g0, dict):
                img_url = g0.get("url") or g0.get("image_url") or g0.get("download_url")
            else:
                img_url = g0
        elif isinstance(generated, str):
            img_url = generated
        else:
            # Print full response to debug
            print(f"Cannot find image URL. Full response: {pdata}")
            sys.exit(1)
        
        if not img_url:
            print(f"No image URL found. Response: {pdata}")
            sys.exit(1)
            
        print(f"Downloading: {img_url[:120]}...")
        img_resp = requests.get(img_url)
        if img_resp.status_code != 200:
            print(f"Download error {img_resp.status_code}")
            sys.exit(1)
        
        out_path = os.path.join(OUTPUT_DIR, "descent-prequel-3x3.png")
        with open(out_path, "wb") as f:
            f.write(img_resp.content)
        
        size_kb = len(img_resp.content) / 1024
        print(f"\nSUCCESS")
        print(f"File: {out_path}")
        print(f"Size: {size_kb:.1f} KB")
        print(f"Model: nano-banana-pro")
        print(f"Task ID: {task_id}")
        break
    
    elif status in ("FAILED", "failed", "error", "ERROR"):
        print(f"ERROR: Generation failed: {pdata}")
        sys.exit(1)
    
    elif status in ("PROCESSING", "processing", "pending", "PENDING", "queued", "QUEUED"):
        continue
    else:
        print(f"Unknown status: {status} — continuing...")
